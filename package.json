{
    "name": "skyguard-weather",
    "version": "1.1.0",
    "description": "A real-time weather monitoring and safety alert MCP server built for Claude Code",
    "type": "module",
    "bin": {
        "skyguard": "dist/cli.js"
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "build": "npm run typecheck && esbuild src/mcp-server.ts src/cli.ts --bundle --platform=node --format=esm --target=node18 --outdir=dist --banner:js='#!/usr/bin/env node'",
        "start": "node dist/mcp-server.js",
        "dev": "tsx src/mcp-server.ts",
        "cli": "node dist/cli.js",
        "test": "echo \"No tests yet\" && exit 0"
    },
    "keywords": ["weather", "mcp", "claude", "safety", "alerts", "monitoring"],
    "author": "Muhammad Hammad",
    "license": "MIT",
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.0.1",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/node": "^20.11.0",
        "esbuild": "^0.24.0",
        "tsx": "^4.19.0",
        "typescript": "^5.3.3"
    }
}
